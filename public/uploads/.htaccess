Options -Indexes

# Tidak ada file PHP yang boleh dieksekusi di folder unggahan
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>