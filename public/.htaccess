Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir file/folder tersembunyi (kecuali .well-known untuk validasi SSL)
    RewriteRule "(^|/)\.(?!well-known(/|$))" - [F,L]

    # Paksa HTTPS. Aktifkan (hapus tanda #) setelah SSL terpasang di hosting.
    # Biarkan nonaktif di komputer lokal.
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By

    # CSS/JS hasil build Vite bernama hash, aman di-cache lama
    <FilesMatch "\.(css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Gambar (unggahan memakai nama acak)
    <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>